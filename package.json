{
  "name": "bouvet-bike",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.14.0",
  "scripts": {
    "dev": "concurrently --names frontend,backend --prefix-colors cyan,green \"pnpm --filter bouvet-bike-frontend dev --host 0.0.0.0\" \"pnpm --filter bouvet-bike-backend dev\"",
    "build": "pnpm --filter bouvet-bike-frontend build && pnpm --filter bouvet-bike-backend build",
    "start": "pnpm --filter bouvet-bike-backend start",
    "db:generate": "pnpm --filter bouvet-bike-backend db:generate",
    "db:migrate": "pnpm --filter bouvet-bike-backend db:migrate",
    "db:migration:create": "node scripts/create-migration.mjs",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "test": "pnpm --recursive --if-present run test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "concurrently": "^9.2.4",
    "prettier": "^3.9.6"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
