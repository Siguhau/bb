# SQLite database path, resolved relative to prisma/schema.prisma. Production
# containers should use a persistent mount, for example file:/data/bouvet-bike.db.
DATABASE_URL="file:./dev.db"

# HTTP port for the Express server.
PORT=3000

# IANA timezone used when assigning calendar due dates.
SHOP_TIME_ZONE=Europe/Oslo

# Customer lookup protection.
LOOKUP_ATTEMPT_LIMIT=5
LOOKUP_BLOCK_DURATION_SECONDS=900
CUSTOMER_ACCESS_GRANT_TTL_SECONDS=900

# Set to the exact number of trusted reverse proxies in front of Express.
TRUST_PROXY_HOPS=0

# Administrator sessions expire after eight hours. Cookies are always HttpOnly,
# SameSite=Strict, and become Secure automatically when NODE_ENV=production.
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_LOGIN_ATTEMPT_LIMIT=5
ADMIN_LOGIN_BLOCK_DURATION_SECONDS=900

# One-shot administrator provisioning. Remove the password after running
# `pnpm --filter bouvet-bike-backend admin:provision`.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-at-least-12-characters
