# SQLite database path, resolved relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# HTTP port for the Express server.
PORT=3000

# IANA timezone used when assigning calendar due dates.
SHOP_TIME_ZONE=Europe/Oslo

# Customer lookup protection.
LOOKUP_ATTEMPT_LIMIT=5
LOOKUP_BLOCK_DURATION_SECONDS=900
CUSTOMER_ACCESS_GRANT_TTL_SECONDS=900

# Set to the exact number of trusted reverse proxies in front of Express.
TRUST_PROXY_HOPS=0
